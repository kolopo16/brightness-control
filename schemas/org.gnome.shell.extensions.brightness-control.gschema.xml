<schemalist>
  <schema id="org.gnome.shell.extensions.brightness-control" path="/org/gnome/shell/extensions/brightness-control/">
    <key name="brightness-up" type="as">
      <default>[]</default>
      <summary>Increase brightness shortcut</summary>
    </key>
    <key name="brightness-down" type="as">
      <default>[]</default>
      <summary>Decrease brightness shortcut</summary>
    </key>
    <key name="use-brightness-keys" type="b">
      <default>true</default>
      <summary>Use the keyboard brightness keys</summary>
    </key>
    <key name="step" type="i">
      <range min="1" max="25" />
      <default>5</default>
      <summary>Brightness step in percent</summary>
    </key>
  </schema>
</schemalist>
